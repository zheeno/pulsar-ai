{
  "name": "pulsar-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run desktop:ui",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "desktop:dev": "npm run agent:build && node scripts/run-with-cargo.mjs npm run desktop:dev -w @ngx/desktop",
    "desktop:ui": "npm run dev -w @ngx/desktop",
    "desktop:build": "node scripts/run-with-cargo.mjs node scripts/tauri-build.mjs current",
    "desktop:build:mac": "node scripts/run-with-cargo.mjs node scripts/tauri-build.mjs mac",
    "desktop:build:win": "node scripts/run-with-cargo.mjs node scripts/tauri-build.mjs win",
    "desktop:prepare": "node scripts/prepare-desktop-resources.mjs",
    "agent:build": "npm run build -w @ngx/shared && npm run build -w @ngx/agent && node scripts/prepare-desktop-resources.mjs",
    "agent:ping": "node scripts/test-agent-ping.js"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.7"
}
