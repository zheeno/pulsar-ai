{
  "name": "pulsar-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run desktop:ui",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "desktop:dev": "export PATH=\"$HOME/.cargo/bin:$PATH\" RUST_LOG=\"info,ngx_pulse=debug\" && npm run desktop:dev -w @ngx/desktop",
    "desktop:ui": "npm run dev -w @ngx/desktop",
    "desktop:build": "export PATH=\"$HOME/.cargo/bin:$PATH\" && npm run desktop:build -w @ngx/desktop",
    "agent:build": "npm run build -w @ngx/agent",
    "agent:ping": "node scripts/test-agent-ping.js"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.7"
}
