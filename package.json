{
  "name": "ngx-ai-trading-assistant",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:seed": "node scripts/seed.js",
    "ngx-pulse:session-test": "node scripts/ngx-pulse-session-test.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy": "bash deploy/deploy.sh",
    "deploy:nginx": "bash deploy/setup-nginx.sh",
    "deploy:build": "docker compose -p pulsar -f docker-compose.prod.yml build",
    "deploy:up": "docker compose -p pulsar -f docker-compose.prod.yml up -d",
    "deploy:down": "docker compose -p pulsar -f docker-compose.prod.yml down",
    "deploy:restart": "docker compose -p pulsar -f docker-compose.prod.yml restart",
    "deploy:ps": "docker compose -p pulsar -f docker-compose.prod.yml ps",
    "deploy:logs": "docker compose -p pulsar -f docker-compose.prod.yml logs -f",
    "deploy:logs:api": "docker compose -p pulsar -f docker-compose.prod.yml logs -f api",
    "deploy:logs:web": "docker compose -p pulsar -f docker-compose.prod.yml logs -f web"
  },
  "devDependencies": {
    "bcrypt": "^5.1.1",
    "mongodb": "^6.12.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.7"
}
