# Desktop / agent environment
#
# Tauri loads the nearest .env (repo root) at startup for Pulse Supabase / base URL.
# Email and password are entered in the app and stored in the OS keychain — do not
# put NGX_PULSE_EMAIL / NGX_PULSE_PASSWORD here for the desktop product.

# App mode: `dev` bypasses NGX market-hours gates for cycles/ingest,
# uses the Wealth App Development API, and opens `pulsar-dev.db` instead of `pulsar.db`
# in the app data directory (same folder; production data is left untouched).
# Default (unset or `production`) enforces market hours and uses Wealth Production.
# APP_ENV=dev
#
# Wealth base URLs (selected automatically from APP_ENV — not set here):
#   dev/development → https://wealthapp-api-stg-app.azurewebsites.net/v1
#   production      → https://api.wealthapp.coronation.ng/v1
# Connect credentials in Settings → Coronation Wealth (stored in OS keychain).

# NGX Pulse API + Supabase Auth (public client config for market data)
NGX_PULSE_BASE_URL=https://ngxpulse.ng/api
NGX_PULSE_SUPABASE_URL=https://your-project.supabase.co
NGX_PULSE_SUPABASE_ANON_KEY=your-anon-key

# Optional: path to LangChain worker (defaults to packages/agent/dist/worker.js)
# NGX_AGENT_WORKER=/absolute/path/to/packages/agent/dist/worker.js

# Node.js version and architecture for the agent worker (used for bundling)
PULSAR_NODE_ARCH=arm64
PULSAR_NODE_VERSION=20.18.1

# Optional: skip Node.js bundling (used for local dev)
# PULSAR_SKIP_NODE_BUNDLE=1