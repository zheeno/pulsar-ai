# Database (Postgres - local docker or Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ngx_trading
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret-for-local-dev

# Redis
REDIS_URL=redis://localhost:6379

# External APIs
NGX_PULSE_API_KEY=your-ngx-pulse-api-key
NGX_PULSE_BASE_URL=https://www.ngxpulse.ng/api
OPENAI_API_KEY=your-openai-api-key

# App
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sandbox defaults
DEFAULT_STARTING_CAPITAL=10000000
SIMULATED_SLIPPAGE_BPS=10
SIMULATED_FEE_PCT=0.0015
