# Database (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/pulsar

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars

# Redis
REDIS_URL=redis://localhost:6379

# External APIs
# NGX Pulse — prefer web session auth (no API tier limits). API key is fallback only.
NGX_PULSE_BASE_URL=https://ngxpulse.ng/api
NGX_PULSE_SUPABASE_URL=https://your-project.supabase.co
NGX_PULSE_SUPABASE_ANON_KEY=your-ngx-pulse-supabase-anon-key
NGX_PULSE_EMAIL=your@email.com
NGX_PULSE_PASSWORD=your-password
# Optional fallback if session credentials are not set
NGX_PULSE_API_KEY=your-ngx-pulse-api-key
OPENAI_API_KEY=your-openai-api-key

# App
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Sandbox defaults
DEFAULT_STARTING_CAPITAL=10000000
SIMULATED_SLIPPAGE_BPS=10
SIMULATED_FEE_PCT=0.0015
