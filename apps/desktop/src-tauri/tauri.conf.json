{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulsar AI",
  "version": "1.0.0",
  "identifier": "com.pulsar.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:resources && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulsar AI",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/agent-worker.cjs",
      "resources/app.env"
    ],
    "externalBin": [],
    "category": "Finance",
    "shortDescription": "Local NGX trading assistant",
    "longDescription": "Pulsar AI is a local-first NGX trading assistant with sandbox and optional Coronation Wealth live trading."
  }
}
