# Production environment — copy to .env and fill in secrets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ngx_trading

DATABASE_URL=postgresql://postgres:change-me-strong-password@postgres:5432/ngx_trading
REDIS_URL=redis://redis:6379

SUPABASE_JWT_SECRET=change-me-jwt-secret-min-32-chars
API_HOST_PORT=3954
WEB_HOST_PORT=3955
# Internal container ports are fixed: API=3001, Web=3000
CORS_ORIGIN=https://pulsar.antimony.com.ng
FORCE_INGEST=true

NEXT_PUBLIC_API_URL=https://pulsar-api.antimony.com.ng/api

# Optional — leave empty to use mock data
NGX_PULSE_API_KEY=
OPENAI_API_KEY=

# Set true on first deploy only
RUN_SEED=true

# Host nginx / Certbot
CERTBOT_EMAIL=admin@antimony.com.ng
WEB_DOMAIN=pulsar.antimony.com.ng
API_DOMAIN=pulsar-api.antimony.com.ng
